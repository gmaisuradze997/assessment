# Public build-time config. Safe to commit — contains no secrets.
# Override PUBLIC_SITE_URL in the deployment environment (Vercel).
PUBLIC_SITE_URL=http://localhost:5173

# Fraction of page loads that ship web-vitals (LCP/INP/CLS/TTFB) to /api/beacon.
# Sticky per session. Errors use a separate always-on rate in code.
PUBLIC_RUM_SAMPLE_RATE=0.25
