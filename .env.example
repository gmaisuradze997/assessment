# Absolute origin of the deployed site, no trailing slash.
PUBLIC_SITE_URL=http://localhost:5173

# Fraction of sessions that report web-vitals to /api/beacon (0–1).
PUBLIC_RUM_SAMPLE_RATE=0.25

# Required in production: secret used to HMAC-sign session cookies.
# Generate with: openssl rand -base64 32
SESSION_SECRET=
